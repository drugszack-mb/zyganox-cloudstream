package com.myextension

import com.lagradost.cloudstream3.*
import com.lagradost.cloudstream3.utils.ExtractorLink
import com.lagradost.cloudstream3.utils.loadExtractor
import org.jsoup.nodes.Document

class KatmovieProvider : MainAPI() {
    override var mainUrl = "https://katmoviehdonline.com"
    override var name = "KatmovieHD"
    override var lang = "hi"
    override val supportedTypes = setOf(
        TvType.Movie,
        TvType.TvSeries
    )

    override val hasMainPage = true

    // Main Page / Home Page Feed
    override suspend fun getMainPage(page: Int, request: MainPageRequest): HomePageResponse {
        val document = app.get("$mainUrl/page/$page/").document
        val home = document.select("article, div.post").mapNotNull {
            it.toSearchResult()
        }
        return newHomePageResponse(request.name, home)
    }

    private fun org.jsoup.nodes.Element.toSearchResult(): SearchResponse? {
        val title = this.selectFirst("h2, h3, .entry-title")?.text() ?: return null
        val href = this.selectFirst("a")?.attr("href") ?: return null
        val posterUrl = this.selectFirst("img")?.attr("src")

        return newMovieSearchResponse(title, href, TvType.Movie) {
            this.posterUrl = posterUrl
        }
    }

    // Search Logic
    override suspend fun search(query: String): List<SearchResponse> {
        val url = "$mainUrl/?s=$query"
        val document = app.get(url).document
        return document.select("article, div.post").mapNotNull {
            it.toSearchResult()
        }
    }

    // Load Details (Movie/Series Page)
    override suspend fun load(url: String): LoadResponse {
        val document = app.get(url).document
        val title = document.selectFirst("h1.entry-title")?.text() ?: "Unknown"
        val poster = document.selectFirst("div.entry-content img")?.attr("src")
        val plot = document.select("div.entry-content p").text()

        // Page par available links collect karna
        val links = document.select("div.entry-content a[href*='drive'], div.entry-content a[href*='download']").map {
            it.attr("href")
        }

        return newMovieLoadResponse(title, url, TvType.Movie, links) {
            this.posterUrl = poster
            this.plot = plot
        }
    }

    // Extract Stream/Download Links
    override suspend fun loadLinks(
        data: String,
        isCasting: Boolean,
        subtitleCallback: (SubtitleFile) -> Unit,
        callback: (ExtractorLink) -> Unit
    ): Boolean {
        // 'data' main humne links list paas ki thi
        val links = data.replace("[", "").replace("]", "").split(",")
        
        for (link in links) {
            val cleanLink = link.trim()
            if (cleanLink.isNotEmpty()) {
                // CloudStream ke Built-in Extractors ka use karna
                loadExtractor(cleanLink, subtitleCallback, callback)
            }
        }
        return true
    }
}
